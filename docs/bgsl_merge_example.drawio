        <!-- ============ MIDDLE: PIPELINE BOX ============ -->
        <mxCell id="pipeline" value="&lt;div style=&quot;padding:12px 18px;text-align:left;font-size:11px;color:#334155;line-height:1.4;&quot;&gt;&lt;div style=&quot;font-size:14px;font-weight:700;color:#0f172a;&quot;&gt;Term-by-term resolver&lt;/div&gt;&lt;br/&gt;&lt;div style=&quot;font-size:10px;font-weight:700;color:#64748b;letter-spacing:0.6px;&quot;&gt;STEP 1 — retrieve&lt;/div&gt;Vector search for row 4 &lt;span style=&quot;font-family:ui-monospace,Menlo,monospace;&quot;&gt;&quot;Asialo-GM1&quot;&lt;/span&gt;:&lt;br/&gt;&lt;span style=&quot;font-family:ui-monospace,Menlo,monospace;color:#0f172a;&quot;&gt;&amp;nbsp;&amp;nbsp;best candidate: asialo-GM1 · score 0.92&lt;br/&gt;&amp;nbsp;&amp;nbsp;runner-up:&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;GA1&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;· score 0.71&lt;/span&gt;&lt;br/&gt;&lt;br/&gt;&lt;div style=&quot;font-size:10px;font-weight:700;color:#64748b;letter-spacing:0.6px;&quot;&gt;STEP 2 — resolve (fast-path fires)&lt;/div&gt;Normalised surface form matches after case-fold:&lt;br/&gt;&lt;span style=&quot;font-family:ui-monospace,Menlo,monospace;color:#0f172a;&quot;&gt;&amp;nbsp;&amp;nbsp;&quot;Asialo-GM1&quot; → asialogm1&lt;br/&gt;&amp;nbsp;&amp;nbsp;&quot;asialo-GM1&quot; → asialogm1&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;✓ same&lt;/span&gt;&lt;br/&gt;Decision: MAP · edge_type = exact_synonym_of&lt;br/&gt;→ no LLM call needed&lt;br/&gt;&lt;br/&gt;&lt;div style=&quot;font-size:10px;font-weight:700;color:#64748b;letter-spacing:0.6px;&quot;&gt;STEP 3 — later, row 6 (&quot;AGM1&quot;) arrives&lt;/div&gt;Vector store now has &quot;asialo-GM1&quot; as an entry.&lt;br/&gt;Surface form doesn&apos;t normalize equal; LLM is called:&lt;br/&gt;&lt;span style=&quot;font-family:ui-monospace,Menlo,monospace;color:#0f172a;&quot;&gt;&amp;nbsp;&amp;nbsp;action:&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&quot;map&quot;&lt;br/&gt;&amp;nbsp;&amp;nbsp;edge_type:&amp;nbsp;&amp;nbsp;&quot;abbreviation_of&quot;&lt;br/&gt;&amp;nbsp;&amp;nbsp;rationale:&amp;nbsp;&amp;nbsp;&quot;AGM1 is a common abbreviation for asialo-GM1.&quot;&lt;/span&gt;&lt;br/&gt;&lt;i&gt;→ AGM1 appended to abbreviations[], no new node created&lt;/i&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ecfeff;strokeColor=#0891b2;strokeWidth=1.8;verticalAlign=top;align=left;" vertex="1" parent="1">
          <mxGeometry x="400" y="178" width="440" height="380" as="geometry" />
        </mxCell>

