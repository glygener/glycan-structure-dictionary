        </mxCell>

        <!-- ============ BOTTOM: EDGE ANNOTATION BOX ============ -->
        <mxCell id="edges_box" value="&lt;div style=&quot;padding:10px 14px;text-align:left;font-size:11px;color:#0f172a;line-height:1.5;&quot;&gt;&lt;div style=&quot;font-size:14px;font-weight:700;color:#0f172a;&quot;&gt;Two edges live in &lt;span style=&quot;font-family:ui-monospace,Menlo,monospace;&quot;&gt;master_edges.json&lt;/span&gt; for this concept:&lt;/div&gt;&lt;br/&gt;&lt;span style=&quot;font-family:ui-monospace,Menlo,monospace;&quot;&gt;{ &quot;subj&quot;: &quot;GSD:asialo-GM1&quot;, &quot;pred&quot;: &quot;has_related_synonym&quot;, &quot;obj&quot;: &quot;GSD:GA1&quot;,&lt;br/&gt;&amp;nbsp;&amp;nbsp;&quot;comment&quot;: &quot;asialo-GM1 has related synonym GA1&quot; }&lt;br/&gt;{ &quot;subj&quot;: &quot;GSD:asialo-GM1&quot;, &quot;pred&quot;: &quot;related_synonym_of&quot;, &quot;obj&quot;: &quot;GSD:Gangliotetraosylceramide&quot;,&lt;br/&gt;&amp;nbsp;&amp;nbsp;&quot;comment&quot;: &quot;curator-hint: asialo-GM1 related_synonym_of Gangliotetraosylceramide&quot; }&lt;/span&gt;&lt;br/&gt;&lt;br/&gt;&lt;span style=&quot;color:#64748b;&quot;&gt;GA1 and Gangliotetraosylceramide share the same underlying chemistry (GTC G21856LC) but are named-entity siblings, not synonyms.&lt;br/&gt;The resolver keeps them as separate concepts and connects them with edges — this is why the GTC-ID fast-path is disabled.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#fca5a5;strokeWidth=1;verticalAlign=top;align=left;" vertex="1" parent="1">
          <mxGeometry x="30" y="720" width="840" height="140" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
