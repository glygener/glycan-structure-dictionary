        <mxCell id="edge_to_ga1" value="has_related_synonym →" style="edgeStyle=none;html=1;strokeColor=#b91c1c;strokeWidth=1.6;dashed=1;dashPattern=5 3;endArrow=classic;endFill=1;endSize=8;fontSize=11;fontStyle=6;fontColor=#b91c1c;exitX=0.35;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="merged_node" target="related_ga1">
