        <mxCell id="row5" value="&lt;div style=&quot;padding:6px 12px;text-align:left;&quot;&gt;&lt;div style=&quot;font-family:ui-monospace,Menlo,monospace;font-size:10px;color:#64748b;&quot;&gt;SRC:GLYCOMOTIF_GGM&lt;/div&gt;&lt;div style=&quot;font-size:13px;font-weight:600;color:#0f172a;margin-top:2px;&quot;&gt;Asialo-GM1&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#334155;margin-top:1px;&quot;&gt;glycomotif_id: GGM.000040 · keyword: ganglioside&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#cbd5e1;strokeWidth=1;verticalAlign=top;align=left;" vertex="1" parent="1">
