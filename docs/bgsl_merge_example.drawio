        <!-- ============ RIGHT: MERGED NODE ============ -->
        <mxCell id="merged_node" value="&lt;div style=&quot;padding:12px 14px;text-align:left;&quot;&gt;&lt;div style=&quot;font-size:16px;font-weight:700;color:#0f172a;&quot;&gt;asialo-GM1&lt;/div&gt;&lt;div style=&quot;font-family:ui-monospace,Menlo,monospace;font-size:10px;color:#64748b;margin-top:2px;&quot;&gt;GSD:8ce1f4e6-8cbe-5167-8ece-a1cfc850d3a5&lt;/div&gt;&lt;hr style=&quot;border:none;border-top:0.8px solid #16a34a;opacity:0.4;margin:8px 0;&quot;/&gt;&lt;div style=&quot;font-size:10px;font-weight:700;color:#64748b;letter-spacing:0.6px;&quot;&gt;PREFERRED LABEL&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#0f172a;&quot;&gt;asialo-GM1&lt;/div&gt;&lt;br/&gt;&lt;div style=&quot;font-size:10px;font-weight:700;color:#64748b;letter-spacing:0.6px;&quot;&gt;EXACT SYNONYMS (5)&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#0f172a;&quot;&gt;Asialo-GM1, asialoGM1, asialo-GM1a, Gg4Cer&lt;/div&gt;&lt;br/&gt;&lt;div style=&quot;font-size:10px;font-weight:700;color:#64748b;letter-spacing:0.6px;&quot;&gt;ABBREVIATIONS (3)&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#0f172a;&quot;&gt;AGM1, aGM1, as-GM1&lt;/div&gt;&lt;br/&gt;&lt;div style=&quot;font-size:10px;font-weight:700;color:#64748b;letter-spacing:0.6px;&quot;&gt;GLYTOUCAN IDS&lt;/div&gt;&lt;div style=&quot;font-family:ui-monospace,Menlo,monospace;font-size:11px;color:#0f172a;&quot;&gt;G21856LC, G00407UJ&lt;/div&gt;&lt;br/&gt;&lt;div style=&quot;font-size:10px;font-weight:700;color:#64748b;letter-spacing:0.6px;&quot;&gt;SOURCES (5)&lt;/div&gt;&lt;div style=&quot;font-family:ui-monospace,Menlo,monospace;font-size:10px;color:#64748b;line-height:1.4;&quot;&gt;EOG_VARKI_4E&lt;br/&gt;GSD_GLYGEN_V0&lt;br/&gt;PUBDICTIONARIES-GLYCAN-IMAGE&lt;br/&gt;CUMMINGS&lt;br/&gt;GLYCOMOTIF_GGM&lt;/div&gt;&lt;br/&gt;&lt;div style=&quot;font-size:10px;font-weight:700;color:#64748b;letter-spacing:0.6px;&quot;&gt;DESCRIPTION&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#0f172a;&quot;&gt;ganglioside missing the sialic acid residue found on GM1&lt;/div&gt;&lt;br/&gt;&lt;div style=&quot;font-size:10px;font-weight:700;color:#64748b;letter-spacing:0.6px;&quot;&gt;EVIDENCE&lt;/div&gt;&lt;div style=&quot;font-size:12px;color:#0f172a;&quot;&gt;EoG ch11 · PMID:17728258 (from GSD_GLYGEN_V0)&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;strokeWidth=2;verticalAlign=top;align=left;" vertex="1" parent="1">
